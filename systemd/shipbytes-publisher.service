[Unit]
Description=Synchronize and publish Ship Bytes issues
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Environment=PUBLICATIONS_PATH=/opt/shipbytes-publications
Environment=SHIPBYTES_DEPLOY_PATH=/home/ubuntu/docker/shipbytes
ExecStart=/home/ubuntu/docker/shipbytes/scripts/sync-and-publish.sh
TimeoutStartSec=90min
StandardOutput=append:/var/log/shipbytes-publisher.log
StandardError=append:/var/log/shipbytes-publisher.log
